# Nagual backend URL (the agent's FastAPI, private Docker network)
NAGUAL_BACKEND_URL=http://nagual:8000

# Dashboard port
PORT=3000

# Admin zone credentials (HTTP Basic). REQUIRED for the admin dashboard:
# without both set the admin zone is disabled (fail-closed). The public zone
# (/watch, /join, /account) works regardless.
NAGUAL_DASH_USER=
NAGUAL_DASH_PASS=

# Optional: your host's public IP — scrubbed from public output by the leak filter
SELF_HOST_IP=
